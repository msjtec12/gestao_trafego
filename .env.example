# ==============================================================================
# KONNEXY ADS — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# NEVER COMMIT REAL SECRETS OR API KEYS TO VERSION CONTROL.
# Copy this file to .env.local for local development.
# NOTE: Production deployments strictly reject placeholder or all-zero secrets.

# --- Application ---
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Konnexy Ads"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="ads.konnexy.com.br"
NEXT_PUBLIC_DEFAULT_EXECUTION_MODE="READ_ONLY"

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://neondb_owner:replace_with_password@ep-example-pooler.sa-east-1.aws.neon.tech/konnexy_ads?sslmode=require"
DATABASE_DIRECT_URL="postgresql://neondb_owner:replace_with_password@ep-example.sa-east-1.aws.neon.tech/konnexy_ads?sslmode=require"

# --- Authentication (Auth.js v5 — Stage 2 Activation) ---
AUTH_SECRET="replace_with_openssl_rand_base64_32_characters_minimum"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Encryption & Security (AES-256-GCM Credential Vault with Key Versioning & AAD) ---
# Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY="a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"
CREDENTIALS_ENCRYPTION_KEY_VERSION="v1"
WEBHOOK_SIGNING_SECRET="replace_with_webhook_hmac_secret"
CRON_SECRET="replace_with_vercel_cron_bearer_secret"

# --- Advertising Providers (OAuth & APIs) ---
# Google Ads API
GOOGLE_ADS_CLIENT_ID="replace_with_google_oauth_client_id"
GOOGLE_ADS_CLIENT_SECRET="replace_with_google_oauth_client_secret"
GOOGLE_ADS_DEVELOPER_TOKEN="replace_with_google_ads_developer_token"

# Meta Marketing API
META_ADS_APP_ID="replace_with_meta_app_id"
META_ADS_APP_SECRET="replace_with_meta_app_secret"

# Microsoft Advertising API
MICROSOFT_ADS_CLIENT_ID="replace_with_microsoft_client_id"
MICROSOFT_ADS_CLIENT_SECRET="replace_with_microsoft_client_secret"
MICROSOFT_ADS_DEVELOPER_TOKEN="replace_with_microsoft_developer_token"

# --- Artificial Intelligence (Vercel AI SDK) ---
OPENAI_API_KEY="sk-replace_with_openai_api_key"
AI_DEFAULT_MODEL="gpt-4o-mini"
AI_STRATEGIC_MODEL="gpt-4o"

# --- Automation & Safety Guardrails ---
AUTOMATION_GLOBAL_KILL_SWITCH="false"
AUTOMATION_MAX_DAILY_BUDGET_CHANGE_PCT="20"
AUTOMATION_MIN_COOLDOWN_MINUTES="360"
